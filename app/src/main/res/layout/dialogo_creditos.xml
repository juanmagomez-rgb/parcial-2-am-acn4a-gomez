<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fondo_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/creditos_padding">

        <ImageView
            android:layout_width="@dimen/creditos_logo_ancho"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/tmdb_logo"
            android:src="@drawable/logo_tmdb" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/poster_margen"
            android:text="@string/tmdb_aviso"
            android:textSize="@dimen/ficha_texto"
            android:textColor="@color/texto_principal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/poster_margen"
            android:autoLink="web"
            android:text="@string/tmdb_fuente"
            android:textSize="@dimen/ficha_texto"
            android:textColorLink="@color/rojo_principal" />
    </LinearLayout>
</ScrollView>
